{
  "name": "nexussecure-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "NexusSecure: Collaborative Attack-Defense Threat Intelligence Mesh for Websites",
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev:hub": "npm --workspace=apps/hub run dev",
    "dev:admin": "npm --workspace=apps/admin-dashboard run dev",
    "dev:portal": "npm --workspace=apps/site-portal run dev",
    "dev:all": "concurrently \"npm run dev:hub\" \"npm run dev:admin\" \"npm run dev:portal\"",
    "build": "npm run build --workspaces --if-present",
    "test:sim": "npm --workspace=examples/demo-websites run test:sim",
    "start:demo": "npm --workspace=examples/demo-websites run start:all"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.5"
  }
}
