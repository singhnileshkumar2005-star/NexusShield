{
  "name": "@nexussecure/agent",
  "version": "1.0.0",
  "description": "Universal real-time collaborative threat intelligence and security agent for Node.js, Next.js, Express, and Fastify.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/middleware/express.d.ts",
      "default": "./dist/middleware/express.js"
    },
    "./next": {
      "types": "./dist/middleware/next.d.ts",
      "default": "./dist/middleware/next.js"
    },
    "./fastify": {
      "types": "./dist/middleware/fastify.d.ts",
      "default": "./dist/middleware/fastify.js"
    },
    "./http": {
      "types": "./dist/middleware/http.d.ts",
      "default": "./dist/middleware/http.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "powershell -Command \"if (Test-Path dist) { Remove-Item -Recurse -Force dist }\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/test/*.test.js"
  },
  "keywords": [
    "security",
    "waf",
    "threat-intelligence",
    "blocklist",
    "ddos-protection",
    "rate-limiting",
    "honeypot",
    "brute-force",
    "sqli",
    "xss",
    "nexussecure",
    "express",
    "nextjs",
    "fastify"
  ],
  "author": "NexusSecure Team",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "express": ">=4.17.0",
    "fastify": ">=4.0.0",
    "next": ">=13.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  }
}
