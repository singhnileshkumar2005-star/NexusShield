# ==============================================================================
# NexusShield SOC Dashboard - Environment Configuration Template
# Copy this file to dashboard/.env for local development or set in Vercel Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Threat Hub Backend Connection
# ------------------------------------------------------------------------------

# Live HTTPS URL of deployed FastAPI Threat Hub (Render / Railway / Custom Domain)
# Local development: http://127.0.0.1:8000
# Production: https://nexusshield-threat-hub.onrender.com
VITE_HUB_API=http://127.0.0.1:8000


# ------------------------------------------------------------------------------
# 2. Authentication & Authorization Credentials
# ------------------------------------------------------------------------------

# Nexus API Key for telemetry queries, stats, and real-time SSE stream subscription
# Matches the NEXUS_API_KEY set on the FastAPI Threat Hub
VITE_NEXUS_API_KEY=nexus_dev_key_2026

# Nexus Admin Secret Token for privileged actions (e.g. unbanning/revoking IP addresses)
# Matches the NEXUS_ADMIN_TOKEN set on the FastAPI Threat Hub
VITE_NEXUS_ADMIN_TOKEN=nexus_admin_secret_2026
