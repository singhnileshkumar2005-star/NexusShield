# ==============================================================================
# NexusShield - Root Environment Configuration Template
# Copy this file to .env and configure values before starting services
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Threat Hub (FastAPI Backend) Configuration
# ------------------------------------------------------------------------------

# Shared API key required for spokes & telemetry ingestion (Header: x-api-key or query: ?api_key=)
# In production, use a strong 32+ character random string (e.g. openssl rand -hex 24)
NEXUS_API_KEY=nexus_dev_key_2026

# Administrative Secret Bearer Token required for high-privilege operations (e.g. IP unban/revoke)
# Header: Authorization: Bearer <TOKEN> or x-admin-token: <TOKEN>
NEXUS_ADMIN_TOKEN=nexus_admin_secret_2026

# Automatic Time-To-Live (TTL) duration in hours for blocked malicious IP addresses
# After this period, temporary bans are automatically expired by SQLite TTL query
BAN_TTL_HOURS=24

# Port for FastAPI Hub server to listen on (Default: 8000 locally, $PORT on Render/Cloud)
PORT=8000


# ------------------------------------------------------------------------------
# 2. Spoke Node (@nexusshield/waf Express Middleware) Configuration
# ------------------------------------------------------------------------------

# Upstream Threat Hub URL where spoke middleware syncs blocklists & reports attack vectors
# Local development: http://127.0.0.1:8000
# Production Render: https://nexusshield-threat-hub.onrender.com
HUB_URL=http://127.0.0.1:8000

# Unique identifier for the client / spoke node reporting threat telemetry
# Examples: client_A, client_B, site_production, checkout_microservice
CLIENT_ID=client_A


# ------------------------------------------------------------------------------
# 3. SOC Dashboard (React / Vite Frontend) Configuration
# ------------------------------------------------------------------------------

# Base URL pointing to the live FastAPI Threat Hub API
# Used by the React dashboard to fetch metrics, blocklists, and subscribe to SSE events
VITE_HUB_API=http://127.0.0.1:8000

# API key for public dashboard telemetry & SSE stream connection
VITE_NEXUS_API_KEY=nexus_dev_key_2026

# Admin secret token used within the SOC dashboard for unbanning/revoking IP addresses
VITE_NEXUS_ADMIN_TOKEN=nexus_admin_secret_2026
